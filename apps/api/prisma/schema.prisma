generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  extensions        = [vector]
}

enum MembershipTier {
  bronze
  silver
  gold
  platinum
}

enum Gender {
  male
  female
  unknown
}

model Member {
  id           String         @id @default(cuid())
  fullName     String
  displayName  String
  phone        String?        @unique
  email        String?        @unique
  gender       Gender         @default(unknown)
  birthYear    Int?
  tier         MembershipTier @default(bronze)
  points       Int            @default(0)
  avatarUrl    String?
  memberSince  DateTime       @default(now())
  faceOptIn    Boolean        @default(false)
  purchases    Purchase[]
  faceEmbeddings FaceEmbedding[]

  @@index([tier])
}

model FaceEmbedding {
  id        String                 @id @default(cuid())
  memberId  String
  member    Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(512)")
  createdAt DateTime               @default(now())

  @@index([memberId])
}

model Product {
  id          String     @id @default(cuid())
  name        String
  category    String
  price       Float
  imageUrl    String?
  targetGender Gender    @default(unknown)
  minAge      Int?
  maxAge      Int?
  timeOfDay   String?    // morning | afternoon | evening | night | any
  active      Boolean    @default(true)
  purchases   PurchaseItem[]

  @@index([category])
}

model Purchase {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  total      Float
  boughtAt   DateTime       @default(now())
  storeCode  String         @default("main")
  items      PurchaseItem[]

  @@index([memberId, boughtAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int      @default(1)
  price      Float

  @@index([productId])
}

model VisitLog {
  id           String   @id @default(cuid())
  memberId     String?
  matchedFace  Boolean  @default(false)
  estimatedAge Int?
  gender       Gender   @default(unknown)
  ageBucket    String?
  storeCode    String   @default("main")
  visitedAt    DateTime @default(now())

  @@index([visitedAt])
}
