generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = for local dev; linux-musl-openssl-3.0.x = for Alpine runtime in ACA
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  extensions        = [vector]
}

enum MembershipTier {
  bronze
  silver
  gold
  platinum
}

enum Gender {
  male
  female
  unknown
}

model Member {
  id           String         @id @default(cuid())
  fullName     String
  displayName  String
  phone        String?        @unique
  email        String?        @unique
  gender       Gender         @default(unknown)
  birthYear    Int?
  tier         MembershipTier @default(bronze)
  points       Int            @default(0)
  avatarUrl    String?
  memberSince  DateTime       @default(now())
  faceOptIn    Boolean        @default(false)
  purchases    Purchase[]
  faceEmbeddings FaceEmbedding[]
  consents     ConsentRecord[]

  @@index([tier])
}

model FaceEmbedding {
  id        String                 @id @default(cuid())
  memberId  String
  member    Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(512)")
  createdAt DateTime               @default(now())

  @@index([memberId])
}

model Product {
  id          String     @id @default(cuid())
  name        String
  category    String
  sku         String?    @unique // barcode/SKU — key used to match items from POS
  price       Float
  imageUrl    String?
  targetGender Gender    @default(unknown)
  minAge      Int?
  maxAge      Int?
  timeOfDay   String?    // morning | afternoon | evening | night | any
  active      Boolean    @default(true)
  purchases   PurchaseItem[]

  @@index([category])
}

model Purchase {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  total      Float
  boughtAt   DateTime       @default(now())
  storeCode  String         @default("main")
  items      PurchaseItem[]

  @@index([memberId, boughtAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int      @default(1)
  price      Float

  @@index([productId])
}

// Integration key for a store's existing POS. The raw key is shown once at
// creation; only its sha256 lands in the DB.
model PosApiKey {
  id         String    @id @default(cuid())
  name       String // e.g. "POS สาขาลาดพร้าว"
  keyHash    String    @unique
  storeCode  String    @default("main")
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model StaffUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("staff") // staff | admin
  createdAt    DateTime @default(now())
}

model Camera {
  id         String   @id @default(cuid())
  name       String
  brand      String   // hikvision | dahua | imou | tapo | xiaomi_hack | reolink | ezviz | uniview | generic
  model      String?  // free-text model name shown in UI
  host       String   // IP or hostname (LAN)
  port       Int      @default(554)
  username   String   @default("admin")
  password   String   // AES-256-GCM (`enc:v1:` prefix) — decrypted only for the bridge endpoint
  streamPath String?  // resolved from brand profile, or custom for generic
  quality    String   @default("sub") // main | sub
  channel    String   @unique // ws channel viewers subscribe to
  bridgeId   String   @default("default") // which bridge agent pulls this camera
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([bridgeId, enabled])
}

// PDPA evidence trail for biometric consent (มาตรา 26). memberId is SetNull on
// member deletion so the record that consent was withdrawn survives erasure.
model ConsentRecord {
  id            String   @id @default(cuid())
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  action        String   // granted | withdrawn
  purpose       String   @default("face_recognition")
  policyVersion String
  policyHash    String?  // sha256 of the exact consent text shown
  method        String   @default("enroll_console")
  staffUserId   String?
  staffUsername String?  // who witnessed/recorded the consent
  createdAt     DateTime @default(now())

  @@index([memberId, createdAt])
}

model VisitLog {
  id           String   @id @default(cuid())
  memberId     String?
  matchedFace  Boolean  @default(false)
  estimatedAge Int?
  gender       Gender   @default(unknown)
  ageBucket    String?
  storeCode    String   @default("main")
  visitedAt    DateTime @default(now())

  @@index([visitedAt])
}
