generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = for local dev; linux-musl-openssl-3.0.x = for Alpine runtime in ACA
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  extensions        = [vector]
}

enum MembershipTier {
  bronze
  silver
  gold
  platinum
}

enum Gender {
  male
  female
  unknown
}

// Tenant root. Every business object below carries orgId — data never crosses
// organizations. bridgeToken authenticates that org's camera bridges.
model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  plan          String   @default("pilot") // pilot | standard | suspended
  // false = Lite tier: phone-lookup only, camera/bridge features refused
  cameraEnabled Boolean  @default(true)
  bridgeToken   String   @unique
  pricePerStore Float    @default(2500) // THB/สาขา/เดือน — ต่อรองรายลูกค้าได้
  createdAt     DateTime @default(now())
}

// Billing: one invoice per org per month (regenerate only after voiding).
model Invoice {
  id       String    @id @default(cuid())
  orgId    String
  number   String    @unique // INV-YYYYMM-XXXX
  period   String // "2026-08"
  amount   Float
  currency String    @default("THB")
  status   String    @default("draft") // draft | sent | paid | void
  note     String?
  dueDate  DateTime?
  issuedAt DateTime  @default(now())
  paidAt   DateTime?

  @@index([orgId, period])
  @@index([status])
}

// Lead from the public landing-page signup form — superadmin works the queue.
model SignupRequest {
  id        String   @id @default(cuid())
  name      String
  storeName String
  phone     String
  email     String?
  message   String?
  status    String   @default("new") // new | contacted | converted | rejected
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Physical branch of an organization. Purchase.storeCode / PosApiKey.storeCode
// reference Store.code (loose coupling — POS data may arrive before the store
// row exists).
model Store {
  id        String   @id @default(cuid())
  orgId     String
  code      String // "BKK-01" — matches storeCode on purchases/POS keys
  name      String
  createdAt DateTime @default(now())

  @@unique([orgId, code])
  @@index([orgId])
}

model Member {
  id           String         @id @default(cuid())
  orgId        String
  fullName     String
  displayName  String
  phone        String?
  email        String?
  gender       Gender         @default(unknown)
  birthYear    Int?
  tier         MembershipTier @default(bronze)
  points       Int            @default(0)
  avatarUrl    String?
  memberSince  DateTime       @default(now())
  faceOptIn    Boolean        @default(false)
  purchases    Purchase[]
  faceEmbeddings FaceEmbedding[]
  consents     ConsentRecord[]

  @@unique([orgId, phone])
  @@unique([orgId, email])
  @@index([tier])
  @@index([orgId])
}

model FaceEmbedding {
  id        String                 @id @default(cuid())
  memberId  String
  member    Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(512)")
  createdAt DateTime               @default(now())

  @@index([memberId])
}

model Product {
  id          String     @id @default(cuid())
  orgId       String
  name        String
  category    String
  sku         String?    // barcode/SKU — key used to match items from POS
  price       Float
  imageUrl    String?
  targetGender Gender    @default(unknown)
  minAge      Int?
  maxAge      Int?
  timeOfDay   String?    // morning | afternoon | evening | night | any
  active      Boolean    @default(true)
  purchases   PurchaseItem[]

  @@unique([orgId, sku])
  @@index([category])
  @@index([orgId])
}

model Purchase {
  id         String         @id @default(cuid())
  orgId      String
  memberId   String
  // true = บิลเกิดภายในหน้าต่าง attribution หลังระบบจำสมาชิกคนนี้ได้ (ROI dashboard)
  assisted   Boolean        @default(false)
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  total      Float
  boughtAt   DateTime       @default(now())
  storeCode  String         @default("main")
  items      PurchaseItem[]

  @@index([memberId, boughtAt])
  @@index([orgId, boughtAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int      @default(1)
  price      Float

  @@index([productId])
}

// Integration key for a store's existing POS. The raw key is shown once at
// creation; only its sha256 lands in the DB.
model PosApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String // e.g. "POS สาขาลาดพร้าว"
  keyHash    String    @unique
  storeCode  String    @default("main")
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([orgId])
}

model StaffUser {
  id           String   @id @default(cuid())
  orgId        String
  username     String   @unique // global — login does not ask for the org
  passwordHash String
  displayName  String
  role         String   @default("staff") // staff | admin (org owner) | superadmin (platform)
  createdAt    DateTime @default(now())

  @@index([orgId])
}

model Camera {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  brand      String   // hikvision | dahua | imou | tapo | xiaomi_hack | reolink | ezviz | uniview | generic
  model      String?  // free-text model name shown in UI
  host       String   // IP or hostname (LAN)
  port       Int      @default(554)
  username   String   @default("admin")
  password   String   // AES-256-GCM (`enc:v1:` prefix) — decrypted only for the bridge endpoint
  streamPath String?  // resolved from brand profile, or custom for generic
  quality    String   @default("sub") // main | sub
  channel    String   // ws channel viewers subscribe to (unique within the org)
  bridgeId   String   @default("default") // which bridge agent pulls this camera
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([orgId, channel])
  @@index([bridgeId, enabled])
  @@index([orgId])
}

// PDPA evidence trail for biometric consent (มาตรา 26). memberId is SetNull on
// member deletion so the record that consent was withdrawn survives erasure.
model ConsentRecord {
  id            String   @id @default(cuid())
  orgId         String
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  action        String   // granted | withdrawn
  purpose       String   @default("face_recognition")
  policyVersion String
  policyHash    String?  // sha256 of the exact consent text shown
  method        String   @default("enroll_console")
  staffUserId   String?
  staffUsername String?  // who witnessed/recorded the consent
  createdAt     DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([orgId])
}

model VisitLog {
  id           String   @id @default(cuid())
  orgId        String
  memberId     String?
  matchedFace  Boolean  @default(false)
  estimatedAge Int?
  gender       Gender   @default(unknown)
  ageBucket    String?
  storeCode    String   @default("main")
  visitedAt    DateTime @default(now())

  @@index([visitedAt])
  @@index([orgId, visitedAt])
}
